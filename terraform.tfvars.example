# EC2 instance type
instance_type = "t3.micro"

# AMI ID (optional, must be in ap-south-1).
# Comment out to use the latest Amazon Linux 2023 AMI (data source lookup).
ami_id = "ami-xxxxxxxxxxxxxxxxx"

# EC2 key pair name (optional, must already exist in AWS, in ap-south-1)
key_name = "my-key-pair"

# Subnet ID (optional, must be in ap-south-1).
# Comment out to use a default VPC subnet.
subnet_id = "subnet-xxxxxxxxxxxxxxxxx"
